# Copy to .env and fill in. Never commit real values.

# --- Server ---
PORT=8000
NODE_ENV=development
PRIVATE_IP=

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# --- Auth ---
ACCESS_SECRET=
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- AWS (S3 uploads, SES email) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# The bucket needs a CORS rule allowing POST from the web origin (knowledge document uploads).
AWS_S3_BUCKET_NAME=
FROM_EMAIL=
SYSTEM_EMAIL=

# --- Anthropic (free-form chat: /api/users/claude-chat) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_REQUEST_TIMEOUT_MS=60000

# --- OpenAI (knowledge base / RAG, see openai-integration-guide.md) ---
# Use separate keys and vector stores for development, staging and production.
OPENAI_API_KEY=
# Confirm current model names in the OpenAI docs. Must support file_search and structured outputs.
OPENAI_MODEL=
# Model used to OCR scanned PDF pages (must accept PDF input). Defaults to OPENAI_MODEL.
OPENAI_OCR_MODEL=
# System corpus vector store (create it once in the OpenAI dashboard or API).
OPENAI_VECTOR_STORE_ID=
OPENAI_REQUEST_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
OPENAI_FILE_SEARCH_MAX_RESULTS=8
OPENAI_CHUNK_MAX_TOKENS=800
OPENAI_CHUNK_OVERLAP_TOKENS=200

# --- AI limits and cost controls (0 = no limit) ---
AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_ITEM_COUNT=20
AI_RATE_LIMIT_PER_MINUTE=10
AI_MONTHLY_BUDGET_USD=0
AI_TENANT_MONTHLY_BUDGET_USD=0
# Prices used only for cost estimates in ai_usage_logs; copy from the current OpenAI pricing page.
AI_PRICE_INPUT_PER_1M_USD=0
AI_PRICE_OUTPUT_PER_1M_USD=0
AI_PRICE_FILE_SEARCH_PER_1K_USD=0

# --- AI ingestion ---
AI_MAX_UPLOAD_MB=100
AI_PAGES_PER_CHUNK=4
AI_TEXT_CHARS_PER_CHUNK=6000
AI_MIN_CHARS_PER_PAGE=20
AI_MAX_REPLACEMENT_CHAR_RATIO=0.01
AI_OCR_ENABLED=false
AI_OCR_MAX_PAGES=300

# --- AI worker (src/worker.ts) ---
AI_WORKER_POLL_MS=2000
AI_WORKER_STALE_JOB_MINUTES=30
